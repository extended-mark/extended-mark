package t;

//@about A quotation.
extern widget said() {
    slot body: view;

    markdown #quot;
}

//@about A title.
extern widget title(value: rich_text) {
    markdown #heading;
}

//@about A title with its level.
extern widget leveled(value: rich_text, level: int 1..3) {
    markdown #heading;
}
