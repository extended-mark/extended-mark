package t;

record stat {
    label: text;
    mut seen: bool = false;
}

fn sweep(mut stats: list<stat>) {
    mut for (t in stats) {
        if (mut s: stat = t) {
            if (s.seen) {
                stats.remove(s);
            } else {
                s.seen = true;
            }
        }
    }
}
