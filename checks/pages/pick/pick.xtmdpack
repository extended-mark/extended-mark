package pick;

//@about The check pack of checks/pages: a widget that writes a value of any type, with an event that
//@about carries one, and a fn its renderer supplies.
pack pick@1 {
    uses core@1;
    provides dial, pick;
}

//@about A value picked from a list, of whatever type the list holds.
extern widget pick<T>(mut value: T, options: list<T>) {
    event moved(by: int 0..3);

    markdown { }
}

//@about How far a dial is turned, as the renderer knows it.
extern fn dial(at: int): int 0..9 {
    return 0;
}
