{
  "about": "each change is tried on a new page of outside.xtmd: what it is refused with, or what it changes and nothing else",
  "changes": [
    {"name": "a whole number in its range", "do": {"set": {"n": {"num": "7"}}}, "state": {"n": {"num": "7"}}},
    {"name": "a number that isn't whole", "do": {"set": {"n": {"num": "3.5"}}}, "refused": [{"code": "contracts.outside", "site": "$state.n"}]},
    {"name": "a number out of its range", "do": {"set": {"n": {"num": "11"}}}, "refused": [{"code": "contracts.outside", "site": "$state.n"}]},
    {"name": "a text for a number", "do": {"set": {"n": {"text": "3"}}}, "refused": [{"code": "contracts.outside", "site": "$state.n"}]},
    {"name": "a field $state doesn't have", "do": {"set": {"nope": {"num": "1"}}}, "refused": [{"code": "contracts.outside", "site": "$state.nope"}]},
    {"name": "a record", "do": {"set": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"num": "2"}, "y": {"num": "1"}}}}}}, "state": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"num": "2"}, "y": {"num": "1"}}}}}},
    {"name": "a record's field out of its contract", "do": {"set": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"num": "99"}, "y": {"num": "0"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.p"}]},
    {"name": "a record's field of another type", "do": {"set": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"text": "2"}, "y": {"num": "0"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.p"}]},
    {"name": "a record without a field it needs", "do": {"set": {"p": {"record": {"type": "doc/pt", "fields": {"y": {"num": "0"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.p"}]},
    {"name": "another record", "do": {"set": {"p": {"record": {"type": "doc/span", "fields": {"low": {"num": "1"}, "high": {"num": "2"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.p"}]},
    {"name": "a record in a list, its field out of its contract", "do": {"set": {"xs": {"list": [{"record": {"type": "doc/pt", "fields": {"x": {"num": "1"}}}}, {"record": {"type": "doc/pt", "fields": {"x": {"num": "99"}}}}]}}}, "refused": [{"code": "contracts.outside", "site": "$state.xs"}]},
    {"name": "a case its enum doesn't have", "do": {"set": {"e": {"case": {"enum": "doc/shape", "name": "NOPE"}}}}, "refused": [{"code": "contracts.outside", "site": "$state.e"}]},
    {"name": "a case without its value", "do": {"set": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE"}}}}, "refused": [{"code": "contracts.outside", "site": "$state.e"}]},
    {"name": "a case's value of another type", "do": {"set": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"text": "x"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.e"}]},
    {"name": "a case's value out of its contract", "do": {"set": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "9"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.e"}]},
    {"name": "a case of another enum", "do": {"set": {"e": {"case": {"enum": "core/color", "name": "INK"}}}}, "refused": [{"code": "contracts.outside", "site": "$state.e"}]},
    {"name": "a case with its value", "do": {"set": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "3"}}}}}}, "state": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "3"}}}}}},
    {"name": "a generic record's field of another type than the use's", "do": {"set": {"b": {"record": {"type": "doc/box", "fields": {"inside": {"text": "x"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.b"}]},
    {"name": "a generic record's field out of the use's contract", "do": {"set": {"b": {"record": {"type": "doc/box", "fields": {"inside": {"num": "1.5"}}}}}}, "refused": [{"code": "contracts.outside", "site": "$state.b"}]},
    {"name": "an opt's value out of its contract", "do": {"set": {"o": {"some": {"num": "9"}}}}, "refused": [{"code": "contracts.outside", "site": "$state.o"}]},
    {"name": "an opt's value", "do": {"set": {"o": {"some": {"num": "4"}}}}, "state": {"o": {"some": {"num": "4"}}}},
    {"name": "a token nothing on the page names", "do": {"set": {"c": {"token": "core/color.C5"}}}, "state": {"c": {"token": "core/color.C5"}}},
    {"name": "a token there isn't", "do": {"set": {"c": {"case": {"enum": "core/color", "name": "NOPE"}}}}, "refused": [{"code": "contracts.outside", "site": "$state.c"}]},
    {"name": "a record whose own rule is false", "do": {"set": {"s": {"record": {"type": "doc/span", "fields": {"low": {"num": "9"}, "high": {"num": "2"}}}}}}, "refused": [{"rule": "low is over high", "site": "$state.s"}]},
    {"name": "an extern value", "do": {"extern": {"n": {"num": "7"}}}, "state": {"host.n": {"num": "7"}}},
    {"name": "a text for an extern number", "do": {"extern": {"n": {"text": "x"}}}, "refused": [{"code": "contracts.outside", "site": "doc/host.n"}]},
    {"name": "an extern value out of its contract", "do": {"extern": {"n": {"num": "99"}}}, "refused": [{"code": "contracts.outside", "site": "doc/host.n"}]},
    {"name": "an extern record with a field out of its contract", "do": {"extern": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"num": "99"}}}}}}, "refused": [{"code": "contracts.outside", "site": "doc/host.p"}]},
    {"name": "an extern value the page doesn't read", "do": {"extern": {"zz": {"num": "1"}}}, "state": {}},
    {"name": "one that fits goes in beside one that doesn't", "do": {"extern": {"n": {"text": "x"}, "s": {"text": "b"}}}, "state": {"host.s": {"text": "b"}}, "refused": [{"code": "contracts.outside", "site": "doc/host.n"}]},
    {"name": "an exposed fn", "do": {"expose": {"name": "put", "args": [{"num": "4"}, {"text": "b"}]}}, "state": {"n": {"num": "4"}, "t": {"text": "b"}}},
    {"name": "an exposed fn's argument out of its contract", "do": {"expose": {"name": "put", "args": [{"num": "99"}, {"text": "b"}]}}, "refused": [{"code": "contracts.outside", "site": "doc/host.put"}]},
    {"name": "an exposed fn's argument of another type", "do": {"expose": {"name": "put", "args": [{"num": "4"}, {"num": "1"}]}}, "refused": [{"code": "contracts.outside", "site": "doc/host.put"}]},
    {"name": "a widget's write into a record's field", "do": {"write": {"id": "s0", "input": "value", "value": {"num": "6"}}}, "state": {"p": {"record": {"type": "doc/pt", "fields": {"x": {"num": "6"}, "y": {"num": "0.5"}}}}}},
    {"name": "a widget's write out of the field's contract", "do": {"write": {"id": "s0", "input": "value", "value": {"num": "99"}}}, "refused": [{"code": "contracts.outside", "site": "s0"}]},
    {"name": "a widget's write that isn't whole", "do": {"write": {"id": "s0", "input": "value", "value": {"num": "2.5"}}}, "refused": [{"code": "contracts.outside", "site": "s0"}]},
    {"name": "a widget's write of another type", "do": {"write": {"id": "s0", "input": "value", "value": {"text": "x"}}}, "refused": [{"code": "contracts.outside", "site": "s0"}]},
    {"name": "a number into a text", "do": {"write": {"id": "s1", "input": "value", "value": {"num": "9"}}}, "refused": [{"code": "contracts.outside", "site": "s1"}]},
    {"name": "a widget's write of a type parameter's type", "do": {"write": {"id": "s2", "input": "value", "value": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "2"}}}}}}, "state": {"e": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "2"}}}}}},
    {"name": "a type parameter's write that isn't the variable's type", "do": {"write": {"id": "s2", "input": "value", "value": {"text": "x"}}}, "refused": [{"code": "contracts.outside", "site": "s2"}]},
    {"name": "a type parameter's write out of a contract inside", "do": {"write": {"id": "s2", "input": "value", "value": {"case": {"enum": "doc/shape", "name": "SQUARE", "values": {"side": {"num": "9"}}}}}}, "refused": [{"code": "contracts.outside", "site": "s2"}]},
    {"name": "a widget's own value", "do": {"write": {"id": "s3", "input": "open", "value": {"bool": true}}}, "state": {"s3.open": {"bool": true}}},
    {"name": "a widget's own value of another type", "do": {"write": {"id": "s3", "input": "open", "value": {"text": "yes"}}}, "refused": [{"code": "contracts.outside", "site": "s3"}]},
    {"name": "an event's argument", "do": {"event": {"id": "s2", "name": "moved", "args": [{"num": "2"}]}}, "state": {"n": {"num": "2"}}},
    {"name": "an event's argument out of its contract", "do": {"event": {"id": "s2", "name": "moved", "args": [{"num": "7"}]}}, "refused": [{"code": "contracts.outside", "site": "s2"}]},
    {"name": "an event's argument of another type", "do": {"event": {"id": "s2", "name": "moved", "args": [{"text": "x"}]}}, "refused": [{"code": "contracts.outside", "site": "s2"}]},
    {"name": "a handler that breaks a record's rule by one field", "do": {"event": {"id": "s6", "name": "click", "args": []}}, "failures": [{"rule": "low is over high", "site": "s6"}]},
    {"name": "a handler that changes both at once", "do": {"event": {"id": "s7", "name": "click", "args": []}}, "state": {"s": {"record": {"type": "doc/span", "fields": {"low": {"num": "5"}, "high": {"num": "9"}}}}}},
    {"name": "a fn's mut parameter out of a local's contract", "do": {"event": {"id": "s8", "name": "click", "args": []}}, "failures": [{"code": "failure.rule", "site": "s8"}]},
    {"name": "a widget's mut input out of a record's field's contract", "do": {"event": {"id": "s9/s0", "name": "click", "args": []}}, "failures": [{"code": "failure.rule", "site": "s9/s0"}]},
    {"name": "a widget's mut input that breaks a record's rule", "do": {"event": {"id": "s10/s0", "name": "click", "args": []}}, "failures": [{"rule": "low is over high", "site": "s10/s0"}]}
  ]
}
