package badge;

//@about The check pack: externs a pack supplies for each platform itself, and one that nobody
//@about supplies, which shows its Markdown instead.
pack badge@1 {
    uses core@2;
    provides badge, seal;
}

//@about A count with its label, drawn by the pack's own widget on each platform it supports.
extern widget badge(label: text, count: int = 0) {
    markdown {
        **\{label}**: \{count}
    }
}

//@about A seal nobody supplies: every renderer shows its Markdown instead.
extern widget seal(text: text) {
    markdown {
        > \{text}
    }
}
