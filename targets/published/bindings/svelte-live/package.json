{
  "name": "@extended-mark/svelte-live",
  "version": "0.3.2",
  "description": "Extended Mark documents in Svelte 5, compiled in the browser as they are edited: <XtmdLiveDoc source={…} />, @extended-mark/wasm's compiler and @extended-mark/svelte's <XtmdDoc>",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "targets/published/bindings/svelte-live"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p . && node scripts/copy-svelte.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build && npm run check && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/svelte": "file:../svelte",
    "@extended-mark/live": "file:../live",
    "@extended-mark/view": "file:../view"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "extended-mark": "file:../../../../compiler/npm/extended-mark",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3"
  }
}
