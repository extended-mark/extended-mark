{
  "name": "extended-mark",
  "version": "0.3.2",
  "description": "Extended Mark's compiler: the xtmd command (a native binary for each platform), a JS API that runs it, and a Vite plugin",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "compiler/npm/extended-mark"
  },
  "type": "module",
  "bin": {
    "xtmd": "bin/xtmd.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "binary": "node scripts/copy-binary.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "@extended-mark/wasm": "file:../wasm",
    "@extended-mark/cli-linux-x64": "0.3.2",
    "@extended-mark/cli-linux-arm64": "0.3.2",
    "@extended-mark/cli-darwin-x64": "0.3.2",
    "@extended-mark/cli-darwin-arm64": "0.3.2",
    "@extended-mark/cli-win32-x64": "0.3.2"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=20"
  }
}
