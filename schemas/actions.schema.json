{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/extended-mark/extended-mark/main/schemas/actions.schema.json",
  "title": "Extended Mark actions 1",
  "description": "What a reader, a widget or a host does to a page (docs/specs/06, The host's side): each is one change, done whole or undone.",
  "x-version": 1,
  "$ref": "#/$defs/action",
  "$defs": {
    "action": {
      "description": "One change from outside.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The node, by its id."
                },
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "tree.schema.json#/$defs/input"
                  }
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "description": "The reader's event on a widget."
        },
        {
          "type": "object",
          "properties": {
            "write": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The node, by its id."
                },
                "input": {
                  "type": "string",
                  "description": "One of its `mut` inputs."
                },
                "value": {
                  "$ref": "tree.schema.json#/$defs/input"
                }
              },
              "required": [
                "id",
                "input",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "write"
          ],
          "additionalProperties": false,
          "description": "A widget writing a `mut` input: checked, then done or refused."
        },
        {
          "type": "object",
          "properties": {
            "set": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "tree.schema.json#/$defs/input"
                  },
                  "description": "`$state`'s fields, by name."
                }
              },
              "required": [
                "fields"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "set"
          ],
          "additionalProperties": false,
          "description": "The host's write to `$state`, as one change."
        },
        {
          "type": "object",
          "properties": {
            "expose": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "tree.schema.json#/$defs/input"
                  }
                }
              },
              "required": [
                "channel",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "expose"
          ],
          "additionalProperties": false,
          "description": "A fn the document exposes, called."
        },
        {
          "type": "object",
          "properties": {
            "extern": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "tree.schema.json#/$defs/input"
                  },
                  "description": "The channel's values, by name."
                }
              },
              "required": [
                "channel",
                "values"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "extern"
          ],
          "additionalProperties": false,
          "description": "A channel's values, given."
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "tree.schema.json#/$defs/input"
                  },
                  "description": "core's page's values, by name: `width`, `theme`, `today`, `now`."
                }
              },
              "required": [
                "values"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false,
          "description": "What the host tells the page about where it is read."
        },
        {
          "type": "object",
          "properties": {
            "restore": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "state.schema.json#/$defs/data"
                }
              },
              "required": [
                "data"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "restore"
          ],
          "additionalProperties": false,
          "description": "The page's data put back as one change, `$state` whole or not at all."
        }
      ]
    }
  }
}
