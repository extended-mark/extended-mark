{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/extended-mark/extended-mark/main/schemas/check.schema.json",
  "title": "Extended Mark cases",
  "description": "A compiler case, the Markdown blocks `xtmd md --format json` writes, and what a runtime says about a page: its drawn widgets, its calls and what it refused.",
  "$ref": "#/$defs/case",
  "$defs": {
    "case": {
      "type": "object",
      "description": "A compiler case: a source, the diagnostics it gives, and the page's Markdown with its starting values.",
      "properties": {
        "id": {
          "type": "string",
          "description": "`group.name`, unique."
        },
        "about": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "The .xtmd or .xtmdpack file, beside the case."
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Packs to build with, beside the case."
        },
        "expect": {
          "type": "object",
          "properties": {
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            },
            "markdown": {
              "$ref": "#/$defs/markdown_expected",
              "description": "The page's Markdown with its starting values, as `xtmd md` writes it, before any step."
            }
          },
          "required": [
            "diagnostics"
          ],
          "additionalProperties": false,
          "description": "What the compiler gives: its diagnostics, and the page's Markdown with its starting values."
        }
      },
      "required": [
        "id",
        "source",
        "expect"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "description": "A diagnostic, by its code and where it starts. Messages are never compared.",
      "properties": {
        "code": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer",
          "description": "Counted in characters, from 1."
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "description": "What the app tells the page about where it is read.",
      "properties": {
        "width": {
          "type": "string",
          "enum": [
            "NARROW",
            "MEDIUM",
            "WIDE"
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "LIGHT",
            "DARK"
          ]
        },
        "today": {
          "type": "string"
        },
        "now": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "markdown_expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "blocks"
          ],
          "additionalProperties": false,
          "description": "The whole page, as blocks."
        },
        {
          "type": "object",
          "properties": {
            "has": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "has"
          ],
          "additionalProperties": false,
          "description": "Blocks somewhere on the page."
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false,
          "description": "The whole page, from a Markdown file beside the case, read as blocks."
        }
      ]
    },
    "mounted": {
      "type": "object",
      "properties": {
        "widget": {
          "type": "string"
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "ir.schema.json#/$defs/expr"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Each slot's children, by site, in order."
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "description": "An extern fn the step called, with its arguments.",
      "properties": {
        "call": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "ir.schema.json#/$defs/expr"
              }
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "call"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "refused": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broken"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broken"
          }
        }
      },
      "additionalProperties": false
    },
    "broken": {
      "type": "object",
      "description": "A rule that failed: a `require`'s message, or a contract's code, and where.",
      "properties": {
        "rule": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "description": "A Markdown block, as the runner reads the page.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "paragraph": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "paragraph"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "heading": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "integer"
                },
                "inline": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/inline"
                  }
                }
              },
              "required": [
                "level",
                "inline"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "heading"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bullets": {
              "type": "object",
              "properties": {
                "ordered": {
                  "type": "boolean"
                },
                "start": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "done": {
                        "type": "boolean"
                      },
                      "blocks": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/block"
                        }
                      }
                    },
                    "required": [
                      "blocks"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "ordered",
                "items"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "bullets"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quote": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "quote"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string"
                },
                "src": {
                  "type": "string"
                }
              },
              "required": [
                "lang",
                "src"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "math": {
              "type": "string"
            }
          },
          "required": [
            "math"
          ],
          "additionalProperties": false,
          "description": "A maths block's TeX."
        },
        {
          "type": "object",
          "properties": {
            "table": {
              "type": "object",
              "properties": {
                "align": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "START",
                      "CENTER",
                      "END"
                    ]
                  }
                },
                "head": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/inline"
                    }
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/inline"
                      }
                    }
                  }
                }
              },
              "required": [
                "align",
                "head",
                "rows"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "footnote": {
              "type": "object",
              "properties": {
                "mark": {
                  "type": "string"
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/block"
                  }
                }
              },
              "required": [
                "mark",
                "blocks"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "footnote"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "divider": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "divider"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "bold": {
                  "type": "boolean"
                },
                "italic": {
                  "type": "boolean"
                },
                "strike": {
                  "type": "boolean"
                },
                "link": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "math": {
              "type": "string"
            }
          },
          "required": [
            "math"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              },
              "required": [
                "src",
                "alt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "required": [
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "break": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "break"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
