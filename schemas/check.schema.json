{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/extended-mark/extended-mark/main/schemas/check.schema.json",
  "title": "Extended Mark cases",
  "description": "A compiler case, the Markdown blocks `xtmd md --format json` writes, and what a runtime says about a page: its drawn widgets, its calls and what it refused.",
  "$ref": "#/$defs/case",
  "$defs": {
    "case": {
      "type": "object",
      "description": "A compiler case: a source, the diagnostics it gives, and the page's Markdown with its starting values.",
      "properties": {
        "id": {
          "type": "string",
          "description": "`group.name`, unique."
        },
        "about": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "The .xtmd or .xtmdpack file, beside the case."
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Packs to build with, beside the case."
        },
        "expect": {
          "type": "object",
          "properties": {
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            },
            "markdown": {
              "$ref": "#/$defs/markdown_expected",
              "description": "The page's Markdown with its starting values, as `xtmd md` writes it, before any step."
            }
          },
          "required": [
            "diagnostics"
          ],
          "additionalProperties": false,
          "description": "What the compiler gives: its diagnostics, and the page's Markdown with its starting values."
        }
      },
      "required": [
        "id",
        "source",
        "expect"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "description": "A diagnostic, by its code and where it starts. Messages are never compared.",
      "properties": {
        "code": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer",
          "description": "Counted in characters, from 1."
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "description": "What the host tells the page about where it is read.",
      "properties": {
        "width": {
          "type": "string",
          "enum": [
            "NARROW",
            "MEDIUM",
            "WIDE"
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "LIGHT",
            "DARK"
          ]
        },
        "today": {
          "type": "string"
        },
        "now": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "markdown_expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "blocks.schema.json#/$defs/block"
              }
            }
          },
          "required": [
            "blocks"
          ],
          "additionalProperties": false,
          "description": "The whole page, as blocks."
        },
        {
          "type": "object",
          "properties": {
            "has": {
              "type": "array",
              "items": {
                "$ref": "blocks.schema.json#/$defs/block"
              }
            }
          },
          "required": [
            "has"
          ],
          "additionalProperties": false,
          "description": "Blocks somewhere on the page."
        },
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false,
          "description": "The whole page, from a Markdown file beside the case, read as blocks."
        }
      ]
    },
    "mounted": {
      "type": "object",
      "properties": {
        "widget": {
          "type": "string"
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "ir.schema.json#/$defs/expr"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Each slot's children, by site, in order."
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "additionalProperties": false
    }
  }
}
