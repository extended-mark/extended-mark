# syntax=docker/dockerfile:1
#
# The playground for a DevBench preview, whose build context is this folder only
# (apps/playground). The rest of the repository it needs (core, the compiler's crates, @extended-mark/runtime,
# @extended-mark/dom, @extended-mark/wasm and the graphs pack) is cloned from GitHub at the same branch; the playground's own
# files come from the context. Dockerfile beside it does the same from the repository root.
#
#   devbench deploy config set markdown-markup/apps/playground --dockerfile Dockerfile.preview --port 8080

ARG REPO=https://github.com/extended-mark/extended-mark
ARG REF=devbench/dsl-format

# ---- 0. the repository at the branch: the ref is fetched first, so a new push is a new layer
#         and the clone is never one an earlier build cached

FROM rust:1-bookworm AS source
ARG REPO
ARG REF
ADD https://api.github.com/repos/extended-mark/extended-mark/git/refs/heads/devbench/dsl-format /tmp/ref.json
RUN git clone --depth 1 --branch "$REF" "$REPO.git" /src

# ---- 1. the compiler: xtmd.wasm, for wasm32-wasip1, with core embedded in it at build time;
#         decNumber's C is compiled by zig's clang (compiler/wasm/zig/cc)

FROM rust:1-bookworm AS compiler
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/zig && /opt/zig/bin/pip install --no-cache-dir ziglang==0.17.1 \
 && rustup target add wasm32-wasip1
ENV XTMD_ZIG="/opt/zig/bin/python -m ziglang"
COPY --from=source /src/core /src/core
COPY --from=source /src/compiler /src/compiler
# the other members of compiler/'s workspace, so cargo can load it
COPY --from=source /src/engines/examples/rust /src/engines/examples/rust
COPY --from=source /src/engines/examples/misc/android/xtmd /src/engines/examples/misc/android/xtmd
COPY --from=source /src/engines/examples/misc/android/xtmd-live /src/engines/examples/misc/android/xtmd-live
RUN /src/compiler/wasm/build.sh /src/xtmd.wasm && test -s /src/xtmd.wasm

# ---- 2. the UI: @extended-mark/runtime, @extended-mark/dom, @extended-mark/wasm and the Targets page's targets (@extended-mark/embed,
#         @extended-mark/live, @extended-mark/embed-live, @extended-mark/view, @extended-mark/react, @extended-mark/react-live) built, then bundled
#         with the playground's own code

FROM node:22-bookworm-slim AS ui
ENV npm_config_fund=false npm_config_audit=false npm_config_update_notifier=false
WORKDIR /src
COPY --from=source /src/engines/published/runtime ./engines/published/runtime
COPY --from=source /src/engines/published/dom ./engines/published/dom
COPY --from=source /src/compiler/npm/wasm ./compiler/npm/wasm
COPY --from=compiler /src/xtmd.wasm ./compiler/npm/wasm/xtmd.wasm
COPY --from=source /src/engines/published/bindings/embed ./engines/published/bindings/embed
COPY --from=source /src/engines/published/bindings/live ./engines/published/bindings/live
COPY --from=source /src/engines/published/bindings/embed-live ./engines/published/bindings/embed-live
COPY --from=source /src/engines/published/bindings/view ./engines/published/bindings/view
COPY --from=source /src/engines/published/bindings/react ./engines/published/bindings/react
COPY --from=source /src/engines/published/bindings/react-live ./engines/published/bindings/react-live
COPY . ./apps/playground
# each package installed, then built, in the order they need each other: npm copies a file:
# package (or links it) as it is then, so what it needs is built first. The packages' tests
# compare them with the binary (xtmd) and @extended-mark/view, which aren't built here
RUN set -e; \
    cd /src/compiler/npm/wasm && npm pkg delete devDependencies.xtmd; \
    cd /src/engines/published/bindings/embed && npm pkg delete devDependencies.xtmd && rm -f package-lock.json; \
    cd /src/engines/published/bindings/live && npm pkg delete devDependencies.@extended-mark/view; \
    for d in view react react-live; do (cd /src/engines/published/bindings/$d && npm pkg delete devDependencies.xtmd && rm -f package-lock.json); done; \
    for d in engines/published/runtime engines/published/dom compiler/npm/wasm engines/published/bindings/embed engines/published/bindings/view engines/published/bindings/live engines/published/bindings/embed-live engines/published/bindings/react engines/published/bindings/react-live; do \
      cd "/src/$d"; \
      rm -rf node_modules dist; \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi; \
      npm run build; \
    done; \
    # a page compiled with xtmd.wasm: a broken one stops the build here
    cd /src/compiler/npm/wasm && node -e "import('./dist/index.js').then(async ({ Compiler }) => { const b = (await Compiler.load()).build('page.xtmd', '# Hello\\n'); if (b.errors || !b.ir) throw new Error(JSON.stringify(b.diagnostics)); })"; \
    cd /src/apps/playground && rm -rf node_modules dist && npm ci && npm run build \
 && test -s dist/app.js && test -s dist/app.css && test -s dist/editor.worker.js && test -s dist/compiler.worker.js && test -s dist/xtmd.wasm \
 && test -s dist/engines.js && test -s dist/engines-counter.ir.json && ls dist/codicon-*.ttf

# ---- 3. what runs

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    PORT=8080
WORKDIR /app
# the packs a page may import (server.mjs: PACKS), where they are in the repo
COPY --from=source /src/examples/graphs ./examples/graphs
COPY --from=ui /src/apps/playground/server.mjs /src/apps/playground/index.html /src/apps/playground/engines.html /src/apps/playground/package.json ./apps/playground/
COPY --from=ui /src/apps/playground/examples ./apps/playground/examples
COPY --from=ui /src/apps/playground/dist ./apps/playground/dist
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 8080) + '/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "apps/playground/server.mjs"]
