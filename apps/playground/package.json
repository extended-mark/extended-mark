{
  "name": "@extended-mark/playground",
  "version": "0.4.0",
  "private": true,
  "description": "The Extended Mark playground: edit a page and see it drawn, with its Markdown, its diagnostics and its $state, live, compiled in the browser",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../renderers/dom",
    "@extended-mark/live": "file:../../live/web",
    "@extended-mark/react": "file:../../renderers/react",
    "@extended-mark/react-live": "file:../../live/react",
    "@extended-mark/runtime": "file:../../runtime/typescript",
    "@extended-mark/wasm": "file:../../compiler/npm/wasm",
    "@extended-mark/widgets": "file:../../widgets/web",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
