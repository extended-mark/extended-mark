{
  "name": "@extended-mark/next",
  "version": "0.4.0",
  "description": "Extended Mark pages in Next.js: <XtmdPage> as a client component, .xtmd imports compiled at build time, and the page's Markdown as HTML for the server",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "renderers/next"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./loader": "./dist/loader.cjs",
    "./xtmd-md": {
      "types": "./xtmd-md.d.ts"
    }
  },
  "files": [
    "dist",
    "xtmd-md.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/react": "file:../react",
    "@extended-mark/runtime": "file:../../runtime/typescript",
    "extended-mark": "file:../../compiler/npm/extended-mark"
  },
  "peerDependencies": {
    "@extended-mark/web": "0.4.0",
    "next": ">=15.3.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@extended-mark/web": "file:../../engines/web",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "bin": {
    "xtmd-next": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "@extended-mark/web": {
      "optional": true
    }
  }
}
