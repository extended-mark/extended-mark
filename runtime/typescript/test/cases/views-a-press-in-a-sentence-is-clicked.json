{
  "id": "views.a-press-in-a-sentence-is-clicked",
  "about": "a view in a sentence is drawn among its paragraph's words, so a press there is in the page's tree and a click on it runs its handler",
  "source": "views-a-press-in-a-sentence-is-clicked.xtmd",
  "expect": {
    "diagnostics": [],
    "markdown": {
      "blocks": [
        {
          "paragraph": [
            {
              "text": {
                "value": "Press Add one and the count, 0, goes up."
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "do": {
        "event": {
          "site": "m0/value/t1",
          "name": "click"
        }
      },
      "expect": {
        "state": {
          "count": {
            "num": "1"
          }
        },
        "tree": {
          "m0": {
            "widget": "core/paragraph",
            "props": {
              "value": {
                "list": [
                  {
                    "text": "m0/value/t0"
                  },
                  {
                    "text": "m0/value/t1"
                  },
                  {
                    "text": "m0/value/t2"
                  },
                  {
                    "text": "m0/value/t3"
                  },
                  {
                    "text": "m0/value/t4"
                  }
                ]
              }
            }
          },
          "m0/value/t0": {
            "widget": "core/words",
            "props": {
              "value": {
                "text": "Press "
              }
            }
          },
          "m0/value/t1": {
            "widget": "core/press",
            "props": {
              "label": {
                "text": "Add one"
              }
            }
          }
        },
        "markdown": {
          "blocks": [
            {
              "paragraph": [
                {
                  "text": {
                    "value": "Press Add one and the count, 1, goes up."
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
