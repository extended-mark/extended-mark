{
  "name": "@extended-mark/web",
  "version": "0.4.0",
  "description": "Extended Mark's web engine: pages built ahead into HTML, CSS and scripts, with no runtime and no IR in them",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "engines/web"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xtmd-web": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./layout": {
      "types": "./dist/kit/layout.d.ts",
      "default": "./dist/kit/layout.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/runtime": "file:../../runtime/typescript",
    "@extended-mark/widgets": "file:../../widgets/web",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@extended-mark/dom": "file:../../renderers/dom",
    "@types/node": "20.19.43",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
