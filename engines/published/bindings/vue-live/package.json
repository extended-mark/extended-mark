    "@extended-mark/widgets": "file:../../widgets"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "extended-mark": "file:../../../../compiler/npm/extended-mark",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vue": "3.5.45"
  }
