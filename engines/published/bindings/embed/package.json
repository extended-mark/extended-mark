{
  "name": "@extended-mark/embed",
  "version": "0.4.0",
  "description": "An Extended Mark page in an element, as every framework binding mounts it; and a page's Markdown as HTML for a server",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "engines/published/bindings/embed"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../dom",
    "@extended-mark/runtime": "file:../../runtime",
    "@extended-mark/view": "file:../view"
  },
  "devDependencies": {
    "extended-mark": "file:../../../../compiler/npm/extended-mark",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
