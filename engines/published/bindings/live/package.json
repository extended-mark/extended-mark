{
  "name": "@extended-mark/live",
  "version": "0.4.0",
  "description": "What every live Extended Mark engine on the web shares: a document's text compiled in the browser by @extended-mark/wasm into the IR a static engine draws, the last page that compiled kept while a draft has errors",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "engines/published/bindings/live"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../dom",
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/runtime": "file:../../runtime",
    "@extended-mark/wasm": "file:../../../../compiler/npm/wasm"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@extended-mark/view": "file:../view"
  }
}
