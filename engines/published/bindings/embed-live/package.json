{
  "name": "@extended-mark/embed-live",
  "version": "0.4.0",
  "description": "Extended Mark documents on the plain web, compiled in the browser as they are edited: new XtmdLiveDoc(element, { source }), @extended-mark/wasm's compiler and @extended-mark/embed's XtmdDoc, drawn by @extended-mark/dom",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "engines/published/bindings/embed-live"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../dom",
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/live": "file:../live",
    "@extended-mark/runtime": "file:../../runtime",
    "@extended-mark/wasm": "file:../../../../compiler/npm/wasm"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
