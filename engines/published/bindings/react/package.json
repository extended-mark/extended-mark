{
  "name": "@extended-mark/react",
  "version": "0.4.0",
  "description": "Extended Mark documents in React 19, run time: <XtmdDoc src={…} /> or ir={…}, drawn by React itself with core's widgets, on a server and in the browser. No compiler; @extended-mark/react-live compiles in the browser",
  "license": "MIT",
  "homepage": "https://github.com/extended-mark/extended-mark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extended-mark/extended-mark.git",
    "directory": "engines/published/bindings/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./built": {
      "types": "./dist/built.d.ts",
      "default": "./dist/built.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/runtime": "file:../../runtime",
    "@extended-mark/widgets": "file:../../widgets"
  },
  "peerDependencies": {
    "@extended-mark/web": "0.4.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@extended-mark/web": "file:../../web",
    "extended-mark": "file:../../../../compiler/npm/extended-mark",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "@types/node": "20.19.43"
  },
  "bin": {
    "xtmd-react": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "@extended-mark/web": {
      "optional": true
    }
  }
}
